generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  HRD_ADMIN
  DEPARTMENT_MANAGER
  VIEWER
}

model Organization {
  id               String             @id @default(uuid())
  name             String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  properties       Property[]
  users            User[]
  departments      Department[]
  positions        Position[]
  employmentStatus EmploymentStatus[]
  employees        Employee[]
  devices          Device[]
  shifts           Shift[]
  holidays         Holiday[]
  rawScans         RawScan[]
  importJobs       ImportJob[]
}

model Property {
  id               String             @id @default(uuid())
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id])
  name             String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  users            User[]
  departments      Department[]
  positions        Position[]
  employmentStatus EmploymentStatus[]
  employees        Employee[]
  devices          Device[]
  shifts           Shift[]
  holidays         Holiday[]
  rawScans         RawScan[]
  importJobs       ImportJob[]
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id])
  email          String       @unique
  password       String
  name           String
  role           Role         @default(VIEWER)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())
}

// ==========================================
// MASTER DATA HRD
// ==========================================

model Department {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id])
  name           String
  code           String?
  employees      Employee[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Position {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id])
  name           String
  employees      Employee[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model EmploymentStatus {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id])
  name           String       
  employees      Employee[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Employee {
  id                 String           @id @default(uuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id])
  propertyId         String
  property           Property         @relation(fields: [propertyId], references: [id])
  nip                String           
  machinePin         String?          
  name               String
  departmentId       String
  department         Department       @relation(fields: [departmentId], references: [id])
  positionId         String
  position           Position         @relation(fields: [positionId], references: [id])
  employmentStatusId String
  employmentStatus   EmploymentStatus @relation(fields: [employmentStatusId], references: [id])
  joinDate           DateTime         @db.Date
  resignDate         DateTime?        @db.Date
  contactInfo        String?
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model Device {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id])
  name           String       
  machineNumber  Int          
  ipAddress      String?      
  serialNumber   String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Shift {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id])
  name           String       
  code           String
  startTime      String       
  endTime        String       
  isNightShift   Boolean      @default(false)
  gracePeriodMin Int          @default(0) 
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Holiday {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id])
  name           String
  date           DateTime     @db.Date
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ==========================================
// IMPORT & RAW SCANS LOG (IMMUTABLE)
// ==========================================

model ImportJob {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  propertyId     String
  property       Property         @relation(fields: [propertyId], references: [id])
  sourceType     String           // "CSV", "PERSONNEL_MYSQL"
  status         String           // "PENDING", "RUNNING", "SUCCEEDED", "FAILED"
  totalRead      Int              @default(0)
  totalValid     Int              @default(0)
  totalInvalid   Int              @default(0)
  totalDuplicate Int              @default(0)
  totalInserted  Int              @default(0)
  errorMessage   String?          @db.Text
  startedAt      DateTime         @default(now())
  finishedAt     DateTime?
  errors         ImportRowError[]
}

model ImportRowError {
  id           String    @id @default(uuid())
  importJobId  String
  importJob    ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  rowNumber    Int
  rawData      String?   @db.Text
  errorMessage String
}

model RawScan {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id])
  
  sourceType     String       // "CSV", "PERSONNEL_MYSQL"
  sourceRecordId String       // ID/Hash dari sumber untuk mencegah duplikasi lintas retry
  
  employeePin    String       // PIN Mesin
  scannedAtUtc   DateTime     // Waktu scan absolut
  
  deviceId       String?      // Nomor/Nama Mesin (jika tersedia dari CSV/MySQL)
  verifyMode     String?      // "1" (Finger), "4" (Face), dll
  inOutState     String?      // Masuk/Keluar (jika didukung mesin)
  
  rawMetadata    Json?        // Seluruh baris asli disensor (untuk audit/tracing)
  createdAt      DateTime     @default(now()) // Waktu ditarik ke dalam sistem Team Connect

  // Kunci gabungan agar 1 rekam jejak dari mesin tidak terimport dua kali walau di-retry
  @@unique([propertyId, sourceType, sourceRecordId])
  
  // Index untuk mempercepat kalkulasi absensi berdasarkan pegawai dan waktu
  @@index([propertyId, employeePin, scannedAtUtc])
}