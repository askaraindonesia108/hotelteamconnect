generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  HRD_ADMIN
  DEPARTMENT_MANAGER
  VIEWER
}

model Organization {
  id               String             @id @default(uuid())
  name             String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  properties       Property[]
  users            User[]
  departments      Department[]
  positions        Position[]
  employmentStatus EmploymentStatus[]
  employees        Employee[]
  devices          Device[]
  shifts           Shift[]
  holidays         Holiday[]
  rawScans         RawScan[]
  importJobs       ImportJob[]
  attendanceRecords AttendanceRecord[]
  leaveRequests    LeaveRequest[]
}

model Property {
  id               String             @id @default(uuid())
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id])
  name             String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  users            User[]
  departments      Department[]
  positions        Position[]
  employmentStatus EmploymentStatus[]
  employees        Employee[]
  devices          Device[]
  shifts           Shift[]
  holidays         Holiday[]
  rawScans         RawScan[]
  importJobs       ImportJob[]
  attendanceRecords AttendanceRecord[]
  leaveRequests    LeaveRequest[]
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id])
  email          String       @unique
  password       String
  name           String
  role           Role         @default(VIEWER)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())
}

model Department {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id])
  name           String
  code           String?
  employees      Employee[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Position {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id])
  name           String
  employees      Employee[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model EmploymentStatus {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id])
  name           String       
  employees      Employee[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Employee {
  id                 String           @id @default(uuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id])
  propertyId         String
  property           Property         @relation(fields: [propertyId], references: [id])
  nip                String           
  machinePin         String?          
  name               String
  departmentId       String
  department         Department       @relation(fields: [departmentId], references: [id])
  positionId         String
  position           Position         @relation(fields: [positionId], references: [id])
  employmentStatusId String
  employmentStatus   EmploymentStatus @relation(fields: [employmentStatusId], references: [id])
  joinDate           DateTime         @db.Date
  resignDate         DateTime?        @db.Date
  contactInfo        String?
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  
  attendanceRecords  AttendanceRecord[]
  leaveRequests      LeaveRequest[]
}

model Device {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id])
  name           String       
  machineNumber  Int          
  ipAddress      String?      
  serialNumber   String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Shift {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id])
  name           String       
  code           String
  startTime      String       
  endTime        String       
  isNightShift   Boolean      @default(false)
  gracePeriodMin Int          @default(0) 
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Holiday {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id])
  name           String
  date           DateTime     @db.Date
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model ImportJob {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  propertyId     String
  property       Property         @relation(fields: [propertyId], references: [id])
  sourceType     String           
  status         String           
  totalRead      Int              @default(0)
  totalValid     Int              @default(0)
  totalInvalid   Int              @default(0)
  totalDuplicate Int              @default(0)
  totalInserted  Int              @default(0)
  errorMessage   String?          @db.Text
  startedAt      DateTime         @default(now())
  finishedAt     DateTime?
  errors         ImportRowError[]
}

model ImportRowError {
  id           String    @id @default(uuid())
  importJobId  String
  importJob    ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  rowNumber    Int
  rawData      String?   @db.Text
  errorMessage String
}

model RawScan {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id])
  
  sourceType     String       
  sourceRecordId String       
  
  employeePin    String       
  scannedAtUtc   DateTime     
  
  deviceId       String?      
  verifyMode     String?      
  inOutState     String?      
  
  rawMetadata    Json?        
  createdAt      DateTime     @default(now()) 

  @@unique([propertyId, sourceType, sourceRecordId])
  @@index([propertyId, employeePin, scannedAtUtc])
}

// ==========================================
// CALCULATED DATA (ATTENDANCE & LEAVES)
// ==========================================

model AttendanceRecord {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id])
  
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id])
  
  date           DateTime     @db.Date
  
  checkIn        DateTime?
  checkOut       DateTime?
  
  status         String       // "PRESENT", "ABSENT", "LEAVE", "DAY_OFF"
  lateMinutes    Int          @default(0)
  earlyMinutes   Int          @default(0)
  
  notes          String?
  isManual       Boolean      @default(false) 
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Mencegah duplikasi absensi pada hari yang sama untuk orang yang sama
  @@unique([employeeId, date])
}

model LeaveRequest {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id])
  
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id])
  
  type           String       // "SICK", "ANNUAL", "UNPAID", "PERMISSION"
  startDate      DateTime     @db.Date
  endDate        DateTime     @db.Date
  reason         String?
  status         String       // "PENDING", "APPROVED", "REJECTED"
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}